# Copy to .env.local and fill in what you need — every var here is optional,
# the app degrades gracefully without any of them (see README.md).

# Stage 1 product search (Shopee Affiliate Open API)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_BASE=

# Stage 2 "✨ ปรับด้วย AI" script polish
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Stage 3 voiceover — falls back to a free unofficial Google Translate TTS endpoint if unset
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Stage 7 Facebook Page post
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Run history / resume (Postgres via Prisma)
DATABASE_URL=
