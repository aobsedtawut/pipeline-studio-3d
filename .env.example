# Copy to .env.local and fill in what you need.
#
# The GOOGLE_*/NEXTAUTH_*/ALLOWED_EMAILS vars below are REQUIRED — the whole
# app is gated behind Google sign-in. Everything else is optional and
# degrades gracefully without it (see README.md).

# Required: Google OAuth sign-in (see README.md "Auth" section for setup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Comma-separated allowlist of Google emails permitted to sign in.
# Defaults to sedtawut.aob@gmail.com if unset.
ALLOWED_EMAILS=

# Stage 1 product search — Shopee (Shopee Affiliate Open API)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_BASE=

# Stage 1 product search — TikTok Shop (Creator Affiliate API)
# Needs DATABASE_URL set too — OAuth tokens are stored in Postgres, they
# can't live in a static env var (see README.md "TikTok Shop" section).
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_API_BASE=
TIKTOK_AUTH_BASE=

# Stage 1 product search — Lazada: no official affiliate/offer-search API
# exists (verified against Lazada Open Platform docs). Use the "กรอกเอง"
# manual-entry tab for Lazada products instead.

# Stage 2 "✨ ปรับด้วย AI" script polish
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Stage 3 voiceover — falls back to a free unofficial Google Translate TTS endpoint if unset
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Stage 7 Facebook Page post (text + cover image only)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# /post-reel — post a full video as a Facebook Reel to any page you manage.
# One user token instead of a per-page token (see README.md "Post a Reel").
FB_USER_ACCESS_TOKEN=

# /post-reel video hosting — Vercel Blob (Storage tab → Create Database →
# Blob in your Vercel project; this gets set automatically once connected).
BLOB_READ_WRITE_TOKEN=

# Run history / resume (Postgres via Prisma)
DATABASE_URL=
